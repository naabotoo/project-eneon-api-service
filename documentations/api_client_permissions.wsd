@startuml "api client permissions"

entity "Permission" as permissions {
    * id: UUID <<pk>> not null
    --
    * key: varchar(255) <<uk>> not null
    * created_on: timestamp DEFAULT now()
    * updated_on: timestamp DEFAULT now()
}

entity "Role" as roles {
    * id: UUID <<pk>>
    --
    * role_id: varchar(255) not null <<uk>>
    * created_on: timestamp DEFAULT now()
    * updated_on: timestamp DEFAULT now()
}

entity "RolePermission" as role_permissions {
    * id: UUID <<pk>>
    --
    * role_id: uuid not null <<fk>>
    * permission_id: uuid not null <<fk>>
    * created_on: timestamp DEFAULT now()
    * updated_on: timestamp DEFAULT now()
}

entity "ClientRole" as client_roles {
    * id: UUID <<pk>>
    --
    * client_id: uuid not null <<fk>>
    * role_id: uuid not null <<fk>>
    * created_on: timestamp DEFAULT now()
    * updated_on: timestamp DEFAULT now()
}

entity "ClientAllowed" as clients_allowed {
     * id: UUID <<pk>>
    --
    * client_id: uuid not null <<fk>>
    * permission_key: jsonb not null
    * created_on: timestamp DEFAULT now()
    * updated_on: timestamp DEFAULT now()
}

entity "ClientDenied" as clients_denied {
     * id: UUID <<pk>>
    --
    * client_id: uuid not null <<fk>>
    * permission_key: jsonb not null
    * created_on: timestamp DEFAULT now()
    * updated_on: timestamp DEFAULT now()
}

entity "Client" as client {
    * id: UUID <<pk>>
    --
    * client_id: varchar(255) NOT NULL <<uk>>
    * client_secret: varchar(500) NOT NULL
    * is_active: bool DEFAULT false
    * created_on: timestamp DEFAULT now()
    * updated_on: timestamp DEFAULT now()
 }

 entity "Company" as companies {

 }

 entity "CompanyUser" as company_users {
    
 }

 client }|-- clients_denied
 client }|-- clients_allowed
 permissions }o-- role_permissions
 roles }o-- role_permissions
 client --o{ client_roles
 roles --o{ client_roles

@enduml